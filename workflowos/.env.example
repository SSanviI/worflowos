# WorkFlowOS Environment Configuration
# Copy this file to .env and fill in your actual credentials.

# ──────────────────────────────────────────────────────────────────────────────
# SLACK INTEGRATION (required for REAL_SLACK mode)
# ──────────────────────────────────────────────────────────────────────────────
# Create an Incoming Webhook at: https://api.slack.com/messaging/webhooks
# Steps:
#   1. Go to https://api.slack.com/apps  →  Create New App → From Scratch
#   2. Enable "Incoming Webhooks" feature
#   3. Click "Add New Webhook to Workspace" and choose your channel
#   4. Copy the Webhook URL below

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WORKSPACE_ID/YOUR_BOT_ID/YOUR_TOKEN

# Set to true to fail (instead of silently falling back) when SLACK_WEBHOOK_URL is not set.
# Useful for CI/CD pipelines and integration testing.
SLACK_STRICT_MODE=false

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE (optional - defaults to SQLite app.db)
# ──────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///app.db

# ──────────────────────────────────────────────────────────────────────────────
# AI ENGINE (optional - enables Gemini AI for workflow understanding)
# ──────────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here
